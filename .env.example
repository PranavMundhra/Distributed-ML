# Worker address advertised to the registry; this no longer configures the gateway.
WORKER_ID=cpu-worker-1
WORKER_URL=http://127.0.0.1:8001
# Start the gateway first. Leave empty for a standalone, unregistered worker.
GATEWAY_URL=http://127.0.0.1:8000
REQUEST_TIMEOUT_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=2
HEARTBEAT_TIMEOUT_SECONDS=8
HEARTBEAT_CHECK_INTERVAL_SECONDS=0.5
LOG_LEVEL=INFO
# Optional: directory containing house_price/ and male_female/ ONNX artifacts.
# Default is models/demo under the repository root. Copy prepared artifacts to each PC.
# DEMO_MODEL_DIR=models/demo
# Local launcher generates DEMO_CONTROL_TOKEN internally for pause/resume demos.
# Manual services leave these controls disabled unless explicitly configured.
